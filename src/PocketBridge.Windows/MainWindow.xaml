<Window x:Class="PocketBridge.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PocketBridge · iPhone에서 Windows로" Width="1180" Height="800" MinWidth="1040" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="#F5F7FB" FontFamily="Segoe UI, Malgun Gothic" FontSize="13">
  <Grid x:Name="RootView" Background="#F5F7FB">
    <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Border Background="#141D30">
      <Grid Margin="20,30,20,22">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="64" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Border Width="34" Height="34" CornerRadius="10" Background="#7366F2" Margin="0,0,10,0">
              <TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="PocketBridge" FontFamily="Segoe UI" Foreground="White" FontWeight="SemiBold" FontSize="19" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="당신의 파일에, 더 넓은 공간을." Foreground="#98A4BB" FontSize="11" Margin="0,14,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="2">
          <TextBlock Text="WORKSPACE" Foreground="#7686A0" FontSize="10" FontWeight="SemiBold" Margin="12,0,0,14" />
          <Border Background="#2B3153" CornerRadius="9" Padding="15,14">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" Foreground="#B4ADFF" FontSize="17" Margin="0,0,13,0" /><TextBlock Text="파일 받기" Foreground="#EEEDFF" FontWeight="SemiBold" /></StackPanel>
          </Border>
          <Button Click="OpenFolder_Click" Background="Transparent" BorderBrush="Transparent" Foreground="#AAB6CB" HorizontalContentAlignment="Left" Margin="0,7,0,0" Padding="15,14" AutomationProperties.Name="저장 폴더 열기">
            <StackPanel Orientation="Horizontal"><Path Data="M1,4 L7,4 9,6 19,6 19,17 1,17 Z" Stroke="#AAB6CB" StrokeThickness="1.5" Width="18" Height="17" Stretch="Uniform" Margin="0,0,13,0" /><TextBlock Text="저장 폴더" Foreground="#AAB6CB" /></StackPanel>
          </Button>
          <Button Click="Help_Click" Background="Transparent" BorderBrush="Transparent" Foreground="#AAB6CB" HorizontalContentAlignment="Left" Margin="0,2,0,0" Padding="15,14">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" Foreground="#AAB6CB" FontSize="17" Margin="0,0,13,0" /><TextBlock Text="시작 가이드" Foreground="#AAB6CB" /></StackPanel>
          </Button>
        </StackPanel>
        <StackPanel Grid.Row="4">
          <Border BorderBrush="#354159" BorderThickness="1" CornerRadius="12" Padding="16,17" Margin="0,0,0,22">
            <StackPanel>
              <TextBlock Text="iPhone → Windows" Foreground="#E1E7F3" FontWeight="SemiBold" FontSize="13" />
              <TextBlock Text="서로 다른 네트워크에서도&#x0a;단축어로 가볍게 연결하세요." Foreground="#91A0B9" FontSize="11" LineHeight="20" Margin="0,8,0,0" />
            </StackPanel>
          </Border>
          <TextBlock Text="OPEN SOURCE  /  v0.1" Foreground="#7889A4" FontSize="10" Margin="5,0,0,0" />
        </StackPanel>
      </Grid>
    </Border>
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid Margin="30,25,30,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="Auto" /><RowDefinition Height="20" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid>
          <StackPanel>
            <TextBlock Text="YOUR FILES, WITH YOU" Foreground="#857BC6" FontSize="10" FontWeight="Bold" />
            <TextBlock Text="작은 화면에서, 더 큰 가능성으로." FontSize="25" FontWeight="Bold" Margin="0,8,0,8" />
            <TextBlock Text="사진부터 문서까지. iPhone의 파일을 내 PC에 안전하게 저장하세요." Foreground="{StaticResource Muted}" FontSize="12" />
          </StackPanel>
          <Border x:Name="StatusBadge" Background="#EBEDF4" CornerRadius="16" Padding="12,7" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,0,0">
            <StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#8B96A9" Margin="0,0,7,0" /><TextBlock x:Name="StatusBadgeText" Text="연결 전" Foreground="#66738A" FontSize="11" FontWeight="SemiBold" /></StackPanel>
          </Border>
        </Grid>
        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions><ColumnDefinition Width="1.18*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Border Style="{StaticResource Card}" Padding="23,22" MinHeight="362">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,19">
                <Border Background="#F0EEFF" CornerRadius="7" Width="27" Height="27" Margin="0,0,10,0"><TextBlock Text="01" Foreground="#7162DB" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <TextBlock Text="받을 준비" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Grid.Row="1">
                <TextBlock Text="중계 서버" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,7" />
                <Grid>
                  <TextBox x:Name="RelayUrlBox" Height="42" ToolTip="운영자가 제공한 HTTPS 서버 주소를 입력하세요." AutomationProperties.Name="중계 서버 HTTPS 주소" FontFamily="Segoe UI" />
                  <TextBlock Text="https://relay.example.com" Foreground="#A0A9BD" FontFamily="Segoe UI" Margin="13,0" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=RelayUrlBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                  </TextBlock>
                </Grid>
                <TextBlock Text="운영자가 제공한 HTTPS 주소를 입력하세요." Foreground="{StaticResource Muted}" FontSize="10" Margin="1,6,0,13" />
              </StackPanel>
              <StackPanel Grid.Row="2">
                <TextBlock Text="저장 위치" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,7" />
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <Border Background="#FAFBFD" BorderBrush="#DBE0EB" BorderThickness="1" CornerRadius="8" Padding="11,11" Margin="0,0,7,0"><TextBlock x:Name="DestinationText" Text="" Foreground="#52617A" TextTrimming="CharacterEllipsis" FontSize="11" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" /></Border>
                  <Button x:Name="ChooseFolderButton" Grid.Column="1" Content="변경" Click="ChooseFolder_Click" Padding="12,8" FontSize="11" />
                </Grid>
              </StackPanel>
              <Grid Grid.Row="3" Margin="0,17,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Button x:Name="StartButton" Click="Start_Click" Style="{StaticResource PrimaryButton}" Padding="12,12">
                  <StackPanel Orientation="Horizontal"><TextBlock x:Name="StartButtonText" Text="연결 QR 만들기" Foreground="White" FontSize="12" FontWeight="SemiBold" /><TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" Foreground="White" Margin="12,2,0,0" /></StackPanel>
                </Button>
                <Button x:Name="DisconnectButton" Grid.Column="1" Content="종료" Click="Disconnect_Click" Visibility="Collapsed" Margin="8,0,0,0" Padding="14,10" />
              </Grid>
              <StackPanel Grid.Row="5" Margin="0,14,0,0">
                <TextBlock x:Name="ConnectionMessage" Text="처음이라면 시작 가이드에서 단축어와 서버를 준비하세요." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="10" LineHeight="17" />
                <ProgressBar x:Name="TransferProgress" Height="5" Margin="0,10,0,0" Minimum="0" Maximum="100" Foreground="#7366EE" Background="#EDEBF8" BorderThickness="0" Visibility="Collapsed" />
                <TextBlock x:Name="ProgressText" Text="" Foreground="#7162DB" FontSize="10" Margin="0,5,0,0" Visibility="Collapsed" />
              </StackPanel>
            </Grid>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource Card}" Padding="21,22" MinHeight="362">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <StackPanel Orientation="Horizontal">
                <Border Background="#F0EEFF" CornerRadius="7" Width="27" Height="27" Margin="0,0,10,0"><TextBlock Text="02" Foreground="#7162DB" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <TextBlock Text="iPhone으로 연결" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>
              <Grid Grid.Row="1" Margin="0,12,0,8" MinHeight="225">
                <StackPanel x:Name="QrPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center">
                  <Grid Width="188" Height="120" Margin="0,0,0,12">
                    <Ellipse Width="120" Height="120" Fill="#F3F0FF" HorizontalAlignment="Center" />
                    <Border Width="93" Height="68" Background="White" BorderBrush="#8D82CE" BorderThickness="2" CornerRadius="6" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0">
                      <Grid><Border Background="#F1EDFF" CornerRadius="3" Margin="6,6,6,12"><TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" Foreground="#7565D4" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><Rectangle Fill="#8D82CE" Height="2" Width="100" VerticalAlignment="Bottom" Margin="0,0,0,-5" /></Grid>
                    </Border>
                    <Border Width="42" Height="78" Background="White" BorderBrush="#7362D6" BorderThickness="2" CornerRadius="8" HorizontalAlignment="Left" Margin="22,16,0,0">
                      <Grid><Border Background="#ECE8FF" CornerRadius="4" Margin="4,8,4,6" /><Border Background="#7362D6" CornerRadius="1" Height="2" Width="12" VerticalAlignment="Top" Margin="0,3,0,0" /></Grid>
                    </Border>
                    <Border Background="#7163E8" Width="28" Height="28" CornerRadius="14" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-20,20,0,0"><TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" Foreground="White" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                  </Grid>
                  <TextBlock Text="파일이 건너올 다리를 만드세요" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" />
                  <TextBlock Text="왼쪽에서 연결 QR을 만들면&#x0a;iPhone 단축어에서 스캔할 수 있어요." Foreground="{StaticResource Muted}" TextAlignment="Center" FontSize="11" LineHeight="19" Margin="0,7,0,0" />
                </StackPanel>
                <StackPanel x:Name="QrPanel" Visibility="Collapsed" VerticalAlignment="Center">
                  <Image x:Name="QrImage" Width="212" Height="212" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" AutomationProperties.Name="iPhone 단축어에서 스캔할 연결 QR 코드" />
                  <TextBlock x:Name="QrCaption" Text="iPhone의 PocketBridge 단축어에서 스캔하세요." Foreground="{StaticResource Muted}" TextAlignment="Center" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel x:Name="ConnectedPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                  <Border Width="76" Height="76" CornerRadius="38" Background="#EAF7F1" Margin="0,0,0,17"><TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="#42A281" FontSize="29" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                  <TextBlock Text="iPhone과 연결되었어요" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
                  <TextBlock Text="공유 시트에서 파일을 더 보내세요.&#x0a;연결을 마치려면 종료를 누르세요." FontSize="11" Foreground="{StaticResource Muted}" TextAlignment="Center" LineHeight="20" Margin="0,8,0,0" />
                </StackPanel>
              </Grid>
              <Grid Grid.Row="2">
                <Button x:Name="CopyInviteButton" Content="연결 정보 복사" Click="CopyInvite_Click" IsEnabled="False" Background="#F8F7FD" Foreground="#7162C4" BorderBrush="#E9E5F7" FontSize="11" Padding="12,9" />
              </Grid>
            </Grid>
          </Border>
        </Grid>
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="22,17" MinHeight="166">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid>
              <StackPanel Orientation="Horizontal"><TextBlock Text="받은 파일" FontSize="16" FontWeight="SemiBold" /><TextBlock x:Name="ReceiptCountText" Text="이번 실행의 기록" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center" Margin="11,2,0,0" /></StackPanel>
              <Button Content="폴더 열기  ↗" Click="OpenFolder_Click" HorizontalAlignment="Right" Background="Transparent" BorderBrush="Transparent" Foreground="#7466D6" FontSize="11" Padding="0,2" />
            </Grid>
            <StackPanel x:Name="EmptyReceipts" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,19,0,11">
              <Border Background="#F2F4F9" CornerRadius="12" Width="45" Height="45" Margin="0,0,14,0"><Path Data="M1,4 L7,4 9,6 19,6 19,17 1,17 Z" Stroke="#A1AEC3" StrokeThickness="1.3" Width="24" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
              <StackPanel VerticalAlignment="Center"><TextBlock Text="아직 받은 파일이 없어요" FontSize="12" Foreground="#71809A" /><TextBlock Text="전송이 완료된 파일이 여기에 표시됩니다." FontSize="10" Foreground="#96A1B3" Margin="0,5,0,0" /></StackPanel>
            </StackPanel>
            <ListBox x:Name="ReceiptList" Grid.Row="1" Visibility="Collapsed" Margin="0,14,0,0" MaxHeight="220" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,6" /><Setter Property="Focusable" Value="False" /></Style></ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate><DataTemplate>
                <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Foreground="#8B80D2" FontSize="18" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="12" ToolTip="{Binding FullPath}" /><TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,3,0,0" /></StackPanel>
                  <TextBlock Grid.Column="2" Text="저장 완료" Foreground="#3A977A" FontSize="10" VerticalAlignment="Center" Margin="0,0,12,0" />
                  <Button Grid.Column="3" Content="위치" Click="ShowReceivedFile_Click" Tag="{Binding FullPath}" FontSize="10" Padding="10,6" AutomationProperties.Name="저장된 파일 위치 열기" />
                </Grid>
              </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Border>
        <Grid Grid.Row="5" Margin="1,15,1,0">
          <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" Foreground="#8794AC" FontSize="11" Margin="0,2,6,0" /><TextBlock Text="HTTPS 전송" Foreground="#7F8BA1" FontSize="10" /><TextBlock Text="  ·  SHA-256 파일 검증" Foreground="#97A1B2" FontSize="10" /></StackPanel>
          <TextBlock Text="원본은 iPhone에 그대로" Foreground="#97A1B2" FontSize="10" HorizontalAlignment="Right" />
        </Grid>
      </Grid>
    </ScrollViewer>
  </Grid>
</Window>
