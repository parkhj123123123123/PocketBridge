<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>PocketBridge</AssemblyName>
    <RootNamespace>PocketBridge.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.0</Version>
    <Description>Native encrypted iPhone-to-Windows file receiver</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../PocketBridge.Core/PocketBridge.Core.csproj" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>
</Project>
